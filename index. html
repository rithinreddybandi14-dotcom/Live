<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WorldTrip - Next-Gen Travel & Itinerary Planner</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & Babel for Browser JSX -->
    <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen">
    <div id="root"></div>

    <script type="text/babel">
        function App() {
            const [activeTab, setActiveTab] = React.useState('explore');
            const [searchQuery, setSearchQuery] = React.useState('');
            const [destinations] = React.useState([
                { id: 1, name: 'Goa Beaches', country: 'India', type: 'Domestic', vibe: 'Relaxed / Party', price: '₹15,000', image: 'https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=600&q=80' },
                { id: 2, name: 'Manali Snow Peaks', country: 'India', type: 'Domestic', vibe: 'Adventure', price: '₹18,000', image: 'https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?auto=format&fit=crop&w=600&q=80' },
                { id: 3, name: 'Dubai Skyline', country: 'UAE', type: 'International', vibe: 'Luxury & Shopping', price: '₹65,000', image: 'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=600&q=80' },
                { id: 4, name: 'Singapore Gardens', country: 'Singapore', type: 'International', vibe: 'Modern / Family', price: '₹75,000', image: 'https://images.unsplash.com/photo-1525625293386-3f8f99389edd?auto=format&fit=crop&w=600&q=80' }
            ]);

            return (
                <div class="flex flex-col min-h-screen">
                    <!-- Navigation Header -->
                    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50 px-6 py-4 flex justify-between items-center">
                        <div class="flex items-center space-x-3">
                            <span class="text-2xl font-black bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text text-transparent">WorldTrip</span>
                            <span class="text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full border border-indigo-500/30">v2.0 Fresh</span>
                        </div>
                        <nav class="hidden md:flex space-x-6 text-sm font-medium text-slate-300">
                            <button onClick={() => setActiveTab('explore')} class={`hover:text-white transition ${activeTab === 'explore' ? 'text-indigo-400 font-bold' : ''}`}>Explore</button>
                            <button onClick={() => setActiveTab('planner')} class={`hover:text-white transition ${activeTab === 'planner' ? 'text-indigo-400 font-bold' : ''}`}>Trip Planner</button>
                            <button onClick={() => setActiveTab('splitter')} class={`hover:text-white transition ${activeTab === 'splitter' ? 'text-indigo-400 font-bold' : ''}`}>Expense Splitter</button>
                            <button onClick={() => setActiveTab('visa')} class={`hover:text-white transition ${activeTab === 'visa' ? 'text-indigo-400 font-bold' : ''}`}>Smart Visas</button>
                        </nav>
                        <div>
                            <button class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-xl text-sm font-semibold transition shadow-lg shadow-indigo-600/30">Client Portal</button>
                        </div>
                    </header>

                    <!-- Main Content Body -->
                    <main class="flex-1 max-w-7xl w-full mx-auto p-6">
                        {activeTab === 'explore' && (
                            <div>
                                <div class="mb-8 text-center max-w-2xl mx-auto">
                                    <h1 class="text-4xl font-extrabold tracking-tight mb-3">Discover Your Next Adventure</h1>
                                    <p class="text-slate-400">Explore handpicked domestic & international destinations with live vibes and smart pricing.</p>
                                    <div class="mt-6 flex gap-3">
                                        <input 
                                            type="text" 
                                            placeholder="Search destinations (e.g., Goa, Dubai)..." 
                                            value={searchQuery}
                                            onChange={(e) => setSearchQuery(e.target.value)}
                                            class="flex-1 bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-indigo-500"
                                        />
                                        <button class="bg-slate-800 hover:bg-slate-700 px-6 py-3 rounded-xl font-semibold transition">Search</button>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                                    {destinations.filter(d => d.name.toLowerCase().includes(searchQuery.toLowerCase()) || d.country.toLowerCase().includes(searchQuery.toLowerCase())).map(dest => (
                                        <div key={dest.id} class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden hover:border-slate-700 transition group">
                                            <div class="h-48 overflow-hidden relative">
                                                <img src={dest.image} alt={dest.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                                                <span class="absolute top-3 right-3 bg-slate-950/80 backdrop-blur text-xs px-2.5 py-1 rounded-full font-medium border border-slate-700">{dest.type}</span>
                                            </div>
                                            <div class="p-5">
                                                <div class="flex justify-between items-start mb-2">
                                                    <h3 class="font-bold text-lg">{dest.name}</h3>
                                                    <span class="text-indigo-400 font-bold text-sm">{dest.price}</span>
                                                </div>
                                                <p class="text-xs text-slate-400 mb-4">{dest.country} • {dest.vibe}</p>
                                                <button class="w-full bg-slate-800 hover:bg-indigo-600 hover:text-white py-2 rounded-xl text-sm font-semibold transition">Plan Itinerary</button>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {activeTab === 'planner' && (
                            <div class="max-w-xl mx-auto bg-slate-900 border border-slate-800 p-8 rounded-3xl">
                                <h2 class="text-2xl font-bold mb-2">AI Smart Trip Planner</h2>
                                <p class="text-slate-400 text-sm mb-6">Configure your preferences to generate an optimized custom itinerary.</p>
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Target Destination</label>
                                        <select class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200">
                                            <option>Goa, India</option>
                                            <option>Manali, India</option>
                                            <option>Dubai, UAE</option>
                                            <option>Singapore</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Trip Duration (Days)</label>
                                        <input type="number" defaultValue="5" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200" />
                                    </div>
                                    <button class="w-full bg-indigo-600 hover:bg-indigo-500 py-3 rounded-xl font-bold transition shadow-lg shadow-indigo-600/30 mt-4">Generate Smart Itinerary</button>
                                </div>
                            </div>
                        )}

                        {activeTab === 'splitter' && (
                            <div class="max-w-xl mx-auto bg-slate-900 border border-slate-800 p-8 rounded-3xl text-center">
                                <h2 class="text-2xl font-bold mb-2">Group Expense Splitter</h2>
                                <p class="text-slate-400 text-sm mb-6">Manage group expenses seamlessly during your trip.</p>
                                <div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 text-slate-400">
                                    <p>No active trip expenses found. Create a trip group to start splitting bills!</p>
                                </div>
                            </div>
                        )}

                        {activeTab === 'visa' && (
                            <div class="max-w-xl mx-auto bg-slate-900 border border-slate-800 p-8 rounded-3xl">
                                <h2 class="text-2xl font-bold mb-2">Sri Karthikeya Smart Visas Integration</h2>
                                <p class="text-slate-400 text-sm mb-6">Direct application tracking and documentation partner support.</p>
                                <div class="space-y-4">
                                    <input type="text" placeholder="Full Name (as per Passport)" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200" />
                                    <input type="text" placeholder="Target Country Visa" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-slate-200" />
                                    <button class="w-full bg-indigo-600 hover:bg-indigo-500 py-3 rounded-xl font-bold transition">Submit Visa Inquiry</button>
                                </div>
                            </div>
                        )}
                    </main>

                    <!-- Footer -->
                    <footer class="border-t border-slate-800 py-6 text-center text-xs text-slate-500">
                        &copy; 2026 WorldTrip. All rights reserved. Designed for Bandi Rithin Reddy.
                    </footer>
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>
